# Wymagane w produkcji (Vercel lub VPS).
AUTH_SECRET=
AUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
# Sekret chroniący endpoint automatycznych powiadomień Discord.
CRON_SECRET=

# Discord OAuth — https://discord.com/developers/applications
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# ID serwera Discord gildii (tryb deweloperski: PPM na serwer → Kopiuj ID serwera)
DISCORD_GUILD_ID=

# Discord ID pierwszych adminów, po przecinku
LEADER_DISCORD_IDS=

# PostgreSQL w produkcji. Na VPS-ie użyj 127.0.0.1:5432 i osobnej bazy elder_hub.
# Lokalnie zostaw puste — Next użyje PGlite w ./data.
DATABASE_URL=
# Opcjonalny bezpośredni adres dla migracji, jeśli DATABASE_URL korzysta z poolera.
DATABASE_URL_UNPOOLED=

# Tylko na własnym komputerze. Nigdy na Vercel.
DEV_LOGIN=true
