# Wymagane na Vercel / w produkcji.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Discord OAuth — https://discord.com/developers/applications
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# ID serwera Discord gildii (tryb deweloperski: PPM na serwer → Kopiuj ID serwera)
DISCORD_GUILD_ID=

# Discord ID pierwszych adminów, po przecinku
LEADER_DISCORD_IDS=

# Neon Postgres. Lokalnie można pominąć — wtedy używany jest plikowy PGlite w ./data
# DATABASE_URL = pooled (aplikacja). DATABASE_URL_UNPOOLED = direct (drizzle-kit).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Tylko na własnym komputerze. Nigdy na Vercel.
DEV_LOGIN=true
