# Wymagane na Vercel / w produkcji.
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Discord OAuth — https://discord.com/developers/applications
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# ID serwera Discord gildii (tryb deweloperski: PPM na serwer → Kopiuj ID serwera)
DISCORD_GUILD_ID=

# Discord ID pierwszych adminów, po przecinku
LEADER_DISCORD_IDS=

# Tylko na Vercel / w produkcji. Lokalnie zostaw puste — Next użyje PGlite w ./data.
# Nie wklejaj tego do .env.local. neon env pull --file .env.neon -s postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Tylko na własnym komputerze. Nigdy na Vercel.
DEV_LOGIN=true
